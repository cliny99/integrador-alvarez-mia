<!DOCTYPE html>
<html>
<head>
    <%- include('partialsDash/headdash') %>
</head>
<body>
    <div class="desktop-image">
        <%- include('partialsDash/headerdash') %>
        <main>
            <h1>Dashboard</h1>
            <p>Total de productos: <%= products.length %></p>
            <%- include('partialsDash/sidebar') %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                        <tr>
                            <td><%= product.id %></td>
                            <td><%= product.name %></td>
                            <td>$<%= product.price %></td>
                            <td><%= product.stock %></td>
                            <td>
                                <a href="/products/edit/<%= product.id %>">Editar</a> |
                                <a href="/products/delete/<%= product.id %>">Eliminar</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <a href="/products/create">Agregar nuevo producto</a>
        </main>
    </div>
    <footer>
    </footer>
</body>
</html>